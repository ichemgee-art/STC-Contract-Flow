rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function activeMember() {
      return signedIn()
        && exists(memberPath())
        && get(memberPath()).data.active == true
        && (
          get(memberPath()).data.role == "admin"
          || get(memberPath()).data.role == "editor"
        );
    }

    function admin() {
      return activeMember() && get(memberPath()).data.role == "admin";
    }

    function validStages(data) {
      return data.stages is map
        && data.stages.keys().hasOnly([
          "stampedByUs",
          "stampedByClient",
          "downPayment",
          "supply",
          "settlement"
        ])
        && data.stages.stampedByUs is bool
        && data.stages.stampedByClient is bool
        && data.stages.downPayment is bool
        && data.stages.supply is bool
        && data.stages.settlement is bool
        && (!data.stages.stampedByClient || data.stages.stampedByUs)
        && (!data.stages.downPayment || data.stages.stampedByClient)
        && (!data.stages.supply || data.stages.downPayment)
        && (!data.stages.settlement || data.stages.supply);
    }

    function validDates(data) {
      return data.stageDates is map
        && data.stageDates.keys().hasOnly([
          "stampedByUs",
          "stampedByClient",
          "downPayment",
          "supply",
          "settlement"
        ])
        && (data.stageDates.stampedByUs == null || data.stageDates.stampedByUs is timestamp)
        && (data.stageDates.stampedByClient == null || data.stageDates.stampedByClient is timestamp)
        && (data.stageDates.downPayment == null || data.stageDates.downPayment is timestamp)
        && (data.stageDates.supply == null || data.stageDates.supply is timestamp)
        && (data.stageDates.settlement == null || data.stageDates.settlement is timestamp)
        && (data.stages.stampedByUs == (data.stageDates.stampedByUs != null))
        && (data.stages.stampedByClient == (data.stageDates.stampedByClient != null))
        && (data.stages.downPayment == (data.stageDates.downPayment != null))
        && (data.stages.supply == (data.stageDates.supply != null))
        && (data.stages.settlement == (data.stageDates.settlement != null));
    }

    function hasContractIdentifier(data) {
      return data.keys().hasAll([
        "contractNumber",
        "contractYear",
        "contractSequence"
      ]);
    }

    function hasAnyContractIdentifier(data) {
      return data.keys().hasAny([
        "contractNumber",
        "contractYear",
        "contractSequence"
      ]);
    }

    function paddedSequence(sequence) {
      return sequence < 10
        ? "000" + string(sequence)
        : sequence < 100
          ? "00" + string(sequence)
          : sequence < 1000
            ? "0" + string(sequence)
            : string(sequence);
    }

    function expectedContractNumber(year, sequence) {
      return "STC-" + string(year) + "-" + paddedSequence(sequence);
    }

    // Egypt is UTC+2 at New Year's midnight. Adding two hours before taking
    // the year gives the business year used by STC even when Firestore's
    // request.time is UTC.
    function cairoYear(value) {
      return (value + duration.value(2, "h")).year();
    }

    function validContractIdentifier(data) {
      return !hasAnyContractIdentifier(data)
        || (
          hasContractIdentifier(data)
          && data.contractNumber is string
          && data.contractYear is int
          && data.contractYear >= 2020
          && data.contractYear <= 2100
          && data.contractSequence is int
          && data.contractSequence >= 1
          && data.contractSequence <= 999999999
          && data.contractNumber == expectedContractNumber(
            data.contractYear,
            data.contractSequence
          )
        );
    }

    function reservationPath(contractNumber) {
      return /databases/$(database)/documents/contractNumberReservations/$(contractNumber);
    }

    function validReservationAfter(contractId, data) {
      return existsAfter(reservationPath(data.contractNumber))
        && getAfter(reservationPath(data.contractNumber)).data.contractId == contractId
        && getAfter(reservationPath(data.contractNumber)).data.year == data.contractYear
        && getAfter(reservationPath(data.contractNumber)).data.sequence == data.contractSequence;
    }

    function identifierTransition(contractId, oldData, newData) {
      let oldHasAny = hasAnyContractIdentifier(oldData);
      let oldHas = hasContractIdentifier(oldData);
      let newHasAny = hasAnyContractIdentifier(newData);
      let newHas = hasContractIdentifier(newData);

      return (
          !oldHasAny
          && !newHasAny
        )
        || (
          !oldHasAny
          && newHas
          && admin()
          && newData.contractYear == cairoYear(oldData.createdAt)
          && validContractIdentifier(newData)
          && validReservationAfter(contractId, newData)
        )
        || (
          oldHas
          && newHas
          && newData.contractNumber == oldData.contractNumber
          && newData.contractYear == oldData.contractYear
          && newData.contractSequence == oldData.contractSequence
        );
    }

    function validContract(data) {
      return data.keys().hasOnly([
          "contractNumber",
          "contractYear",
          "contractSequence",
          "salesRepresentative",
          "companyName",
          "contractType",
          "product",
          "stages",
          "stageDates",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByName"
        ])
        && data.salesRepresentative is string
        && data.salesRepresentative.size() >= 2
        && data.salesRepresentative.size() <= 100
        && data.salesRepresentative.matches(".*[^\\s].*")
        && data.companyName is string
        && data.companyName.size() >= 2
        && data.companyName.size() <= 160
        && data.companyName.matches(".*[^\\s].*")
        && data.contractType is string
        && data.contractType.size() >= 2
        && data.contractType.size() <= 120
        && data.contractType.matches(".*[^\\s].*")
        && data.product is string
        && data.product.size() >= 1
        && data.product.size() <= 120
        && data.product.matches(".*[^\\s].*")
        && data.createdBy is string
        && data.createdByName is string
        && data.createdByName.size() >= 1
        && data.createdByName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validContractIdentifier(data)
        && validStages(data)
        && validDates(data);
    }

    function pristineWorkflow(data) {
      return data.stages.stampedByUs == false
        && data.stages.stampedByClient == false
        && data.stages.downPayment == false
        && data.stages.supply == false
        && data.stages.settlement == false
        && data.stageDates.stampedByUs == null
        && data.stageDates.stampedByClient == null
        && data.stageDates.downPayment == null
        && data.stageDates.supply == null
        && data.stageDates.settlement == null;
    }

    function stageCompleted(oldStage, newStage, newDate) {
      return oldStage == false
        && newStage == true
        && newDate == request.time;
    }

    function stageReopened(oldStage, newStage, newDate) {
      return oldStage == true
        && newStage == false
        && newDate == null;
    }

    function validStageTransitions(oldData, newData) {
      let changedStages = newData.stages.diff(oldData.stages).affectedKeys();
      let changedDates = newData.stageDates.diff(oldData.stageDates).affectedKeys();

      // Editing basic contract fields is allowed when the workflow itself is
      // untouched.
      return (
          changedStages.size() == 0
          && changedDates.size() == 0
        )
        // Forward progress: exactly one stage and its own timestamp may change.
        || (
          changedStages.hasOnly(["stampedByUs"])
          && changedDates.hasOnly(["stampedByUs"])
          && stageCompleted(
            oldData.stages.stampedByUs,
            newData.stages.stampedByUs,
            newData.stageDates.stampedByUs
          )
        )
        || (
          changedStages.hasOnly(["stampedByClient"])
          && changedDates.hasOnly(["stampedByClient"])
          && stageCompleted(
            oldData.stages.stampedByClient,
            newData.stages.stampedByClient,
            newData.stageDates.stampedByClient
          )
        )
        || (
          changedStages.hasOnly(["downPayment"])
          && changedDates.hasOnly(["downPayment"])
          && stageCompleted(
            oldData.stages.downPayment,
            newData.stages.downPayment,
            newData.stageDates.downPayment
          )
        )
        || (
          changedStages.hasOnly(["supply"])
          && changedDates.hasOnly(["supply"])
          && stageCompleted(
            oldData.stages.supply,
            newData.stages.supply,
            newData.stageDates.supply
          )
        )
        || (
          changedStages.hasOnly(["settlement"])
          && changedDates.hasOnly(["settlement"])
          && stageCompleted(
            oldData.stages.settlement,
            newData.stages.settlement,
            newData.stageDates.settlement
          )
        )
        // Reopening a stage may clear only that stage and stages after it.
        // Earlier progress and timestamps are immutable in the same request.
        || (
          changedStages.hasOnly([
            "stampedByUs",
            "stampedByClient",
            "downPayment",
            "supply",
            "settlement"
          ])
          && changedDates.hasOnly([
            "stampedByUs",
            "stampedByClient",
            "downPayment",
            "supply",
            "settlement"
          ])
          && stageReopened(
            oldData.stages.stampedByUs,
            newData.stages.stampedByUs,
            newData.stageDates.stampedByUs
          )
          && newData.stages.stampedByClient == false
          && newData.stageDates.stampedByClient == null
          && newData.stages.downPayment == false
          && newData.stageDates.downPayment == null
          && newData.stages.supply == false
          && newData.stageDates.supply == null
          && newData.stages.settlement == false
          && newData.stageDates.settlement == null
        )
        || (
          changedStages.hasOnly([
            "stampedByClient",
            "downPayment",
            "supply",
            "settlement"
          ])
          && changedDates.hasOnly([
            "stampedByClient",
            "downPayment",
            "supply",
            "settlement"
          ])
          && stageReopened(
            oldData.stages.stampedByClient,
            newData.stages.stampedByClient,
            newData.stageDates.stampedByClient
          )
          && newData.stages.downPayment == false
          && newData.stageDates.downPayment == null
          && newData.stages.supply == false
          && newData.stageDates.supply == null
          && newData.stages.settlement == false
          && newData.stageDates.settlement == null
        )
        || (
          changedStages.hasOnly(["downPayment", "supply", "settlement"])
          && changedDates.hasOnly(["downPayment", "supply", "settlement"])
          && stageReopened(
            oldData.stages.downPayment,
            newData.stages.downPayment,
            newData.stageDates.downPayment
          )
          && newData.stages.supply == false
          && newData.stageDates.supply == null
          && newData.stages.settlement == false
          && newData.stageDates.settlement == null
        )
        || (
          changedStages.hasOnly(["supply", "settlement"])
          && changedDates.hasOnly(["supply", "settlement"])
          && stageReopened(
            oldData.stages.supply,
            newData.stages.supply,
            newData.stageDates.supply
          )
          && newData.stages.settlement == false
          && newData.stageDates.settlement == null
        )
        || (
          changedStages.hasOnly(["settlement"])
          && changedDates.hasOnly(["settlement"])
          && stageReopened(
            oldData.stages.settlement,
            newData.stages.settlement,
            newData.stageDates.settlement
          )
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /contracts/{contractId} {
      allow read: if activeMember();

      allow create: if activeMember()
        && hasContractIdentifier(request.resource.data)
        && validContract(request.resource.data)
        && request.resource.data.contractYear == cairoYear(request.time)
        && validReservationAfter(contractId, request.resource.data)
        && pristineWorkflow(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName == get(memberPath()).data.displayName
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeMember()
        && validContract(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && identifierTransition(contractId, resource.data, request.resource.data)
        && validStageTransitions(resource.data, request.resource.data);

      allow delete: if admin();

      match /notes/{noteId} {
        allow read: if activeMember()
          && (
            admin()
            || exists(/databases/$(database)/documents/contracts/$(contractId))
          );

        allow create: if activeMember()
          && exists(/databases/$(database)/documents/contracts/$(contractId))
          && request.resource.data.keys().hasOnly([
            "text",
            "createdAt",
            "createdBy",
            "createdByName"
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.text.matches(".*[^\\s].*")
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName == get(memberPath()).data.displayName;

        allow update: if false;

        allow delete: if activeMember()
          && (
            admin()
            || (
              exists(/databases/$(database)/documents/contracts/$(contractId))
              && resource.data.createdBy == request.auth.uid
            )
          );
      }
    }

    match /contractNumberReservations/{contractNumber} {
      allow read: if admin();

      allow create: if activeMember()
        && request.resource.data.keys().hasOnly([
          "contractId",
          "year",
          "sequence",
          "createdAt"
        ])
        && request.resource.data.contractId is string
        && request.resource.data.contractId.size() >= 1
        && request.resource.data.contractId.size() <= 160
        && request.resource.data.year is int
        && request.resource.data.year >= 2020
        && request.resource.data.year <= 2100
        && request.resource.data.sequence is int
        && request.resource.data.sequence >= 1
        && request.resource.data.sequence <= 999999999
        && contractNumber == expectedContractNumber(
          request.resource.data.year,
          request.resource.data.sequence
        )
        && request.resource.data.createdAt == request.time
        && existsAfter(
          /databases/$(database)/documents/contracts/$(request.resource.data.contractId)
        )
        && getAfter(
          /databases/$(database)/documents/contracts/$(request.resource.data.contractId)
        ).data.contractNumber == contractNumber
        && getAfter(
          /databases/$(database)/documents/contracts/$(request.resource.data.contractId)
        ).data.contractYear == request.resource.data.year
        && getAfter(
          /databases/$(database)/documents/contracts/$(request.resource.data.contractId)
        ).data.contractSequence == request.resource.data.sequence
        && existsAfter(
          /databases/$(database)/documents/contractCounters/$(string(request.resource.data.year))
        )
        && getAfter(
          /databases/$(database)/documents/contractCounters/$(string(request.resource.data.year))
        ).data.value == request.resource.data.sequence
        && getAfter(
          /databases/$(database)/documents/contractCounters/$(string(request.resource.data.year))
        ).data.lastReservation == contractNumber
        && getAfter(
          /databases/$(database)/documents/contractCounters/$(string(request.resource.data.year))
        ).data.lastContractId == request.resource.data.contractId;

      allow update, delete: if false;
    }

    match /contractCounters/{counterId} {
      allow read: if activeMember();

      allow create: if activeMember()
        && request.resource.data.keys().hasOnly([
          "year",
          "value",
          "lastReservation",
          "lastContractId",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "year",
          "value",
          "lastReservation",
          "lastContractId",
          "updatedAt"
        ])
        && request.resource.data.year is int
        && counterId == string(request.resource.data.year)
        && request.resource.data.year >= 2020
        && request.resource.data.year <= 2100
        && request.resource.data.value == 1
        && request.resource.data.lastReservation is string
        && request.resource.data.lastContractId is string
        && request.resource.data.updatedAt == request.time
        && existsAfter(reservationPath(request.resource.data.lastReservation))
        && getAfter(reservationPath(request.resource.data.lastReservation)).data.contractId
          == request.resource.data.lastContractId
        && getAfter(reservationPath(request.resource.data.lastReservation)).data.year
          == request.resource.data.year
        && getAfter(reservationPath(request.resource.data.lastReservation)).data.sequence
          == request.resource.data.value;

      allow update: if activeMember()
        && request.resource.data.keys().hasOnly([
          "year",
          "value",
          "lastReservation",
          "lastContractId",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "year",
          "value",
          "lastReservation",
          "lastContractId",
          "updatedAt"
        ])
        && request.resource.data.year == resource.data.year
        && counterId == string(request.resource.data.year)
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.value <= 999999999
        && request.resource.data.lastReservation is string
        && request.resource.data.lastContractId is string
        && request.resource.data.updatedAt == request.time
        && existsAfter(reservationPath(request.resource.data.lastReservation))
        && getAfter(reservationPath(request.resource.data.lastReservation)).data.contractId
          == request.resource.data.lastContractId
        && getAfter(reservationPath(request.resource.data.lastReservation)).data.year
          == request.resource.data.year
        && getAfter(reservationPath(request.resource.data.lastReservation)).data.sequence
          == request.resource.data.value;

      allow delete: if false;
    }
  }
}
