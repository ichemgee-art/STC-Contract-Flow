rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function activeMember() {
      return signedIn()
        && exists(memberPath())
        && get(memberPath()).data.active == true
        && (
          get(memberPath()).data.role == "admin"
          || get(memberPath()).data.role == "editor"
        );
    }

    function admin() {
      return activeMember() && get(memberPath()).data.role == "admin";
    }

    function validStages(data) {
      return data.stages is map
        && data.stages.keys().hasOnly([
          "stampedByUs",
          "stampedByClient",
          "downPayment",
          "supply",
          "settlement"
        ])
        && data.stages.stampedByUs is bool
        && data.stages.stampedByClient is bool
        && data.stages.downPayment is bool
        && data.stages.supply is bool
        && data.stages.settlement is bool
        && (!data.stages.stampedByClient || data.stages.stampedByUs)
        && (!data.stages.downPayment || data.stages.stampedByClient)
        && (!data.stages.supply || data.stages.downPayment)
        && (!data.stages.settlement || data.stages.supply);
    }

    function validDates(data) {
      return data.stageDates is map
        && data.stageDates.keys().hasOnly([
          "stampedByUs",
          "stampedByClient",
          "downPayment",
          "supply",
          "settlement"
        ])
        && (data.stageDates.stampedByUs == null || data.stageDates.stampedByUs is timestamp)
        && (data.stageDates.stampedByClient == null || data.stageDates.stampedByClient is timestamp)
        && (data.stageDates.downPayment == null || data.stageDates.downPayment is timestamp)
        && (data.stageDates.supply == null || data.stageDates.supply is timestamp)
        && (data.stageDates.settlement == null || data.stageDates.settlement is timestamp)
        && (data.stages.stampedByUs == (data.stageDates.stampedByUs != null))
        && (data.stages.stampedByClient == (data.stageDates.stampedByClient != null))
        && (data.stages.downPayment == (data.stageDates.downPayment != null))
        && (data.stages.supply == (data.stageDates.supply != null))
        && (data.stages.settlement == (data.stageDates.settlement != null));
    }

    function validContract(data) {
      return data.keys().hasOnly([
          "salesRepresentative",
          "companyName",
          "contractType",
          "product",
          "stages",
          "stageDates",
          "createdAt",
          "updatedAt",
          "createdBy",
          "createdByName"
        ])
        && data.salesRepresentative is string
        && data.salesRepresentative.size() >= 2
        && data.salesRepresentative.size() <= 100
        && data.companyName is string
        && data.companyName.size() >= 2
        && data.companyName.size() <= 160
        && data.contractType is string
        && data.contractType.size() >= 2
        && data.contractType.size() <= 120
        && data.product is string
        && data.product.size() >= 1
        && data.product.size() <= 120
        && data.createdBy is string
        && data.createdByName is string
        && data.createdByName.size() >= 1
        && data.createdByName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && validStages(data)
        && validDates(data);
    }

    function pristineWorkflow(data) {
      return data.stages.stampedByUs == false
        && data.stages.stampedByClient == false
        && data.stages.downPayment == false
        && data.stages.supply == false
        && data.stages.settlement == false
        && data.stageDates.stampedByUs == null
        && data.stageDates.stampedByClient == null
        && data.stageDates.downPayment == null
        && data.stageDates.supply == null
        && data.stageDates.settlement == null;
    }

    function stageUnchanged(oldStage, newStage, oldDate, newDate) {
      return newStage == oldStage && newDate == oldDate;
    }

    function stageCompleted(oldStage, newStage, newDate) {
      return oldStage == false
        && newStage == true
        && newDate == request.time;
    }

    function stageReopened(oldStage, newStage, newDate) {
      return oldStage == true
        && newStage == false
        && newDate == null;
    }

    function validStageTransitions(oldData, newData) {
      // Basic-detail edits may leave the complete workflow untouched.
      let unchanged =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageUnchanged(oldData.stages.downPayment, newData.stages.downPayment, oldData.stageDates.downPayment, newData.stageDates.downPayment)
        && stageUnchanged(oldData.stages.supply, newData.stages.supply, oldData.stageDates.supply, newData.stageDates.supply)
        && stageUnchanged(oldData.stages.settlement, newData.stages.settlement, oldData.stageDates.settlement, newData.stageDates.settlement);

      // A forward action may complete exactly one stage. All other stages and
      // their timestamps must stay untouched. validContract() separately
      // guarantees that every prerequisite stage is already complete.
      let completeStampedByUs =
        stageCompleted(oldData.stages.stampedByUs, newData.stages.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageUnchanged(oldData.stages.downPayment, newData.stages.downPayment, oldData.stageDates.downPayment, newData.stageDates.downPayment)
        && stageUnchanged(oldData.stages.supply, newData.stages.supply, oldData.stageDates.supply, newData.stageDates.supply)
        && stageUnchanged(oldData.stages.settlement, newData.stages.settlement, oldData.stageDates.settlement, newData.stageDates.settlement);

      let completeStampedByClient =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageCompleted(oldData.stages.stampedByClient, newData.stages.stampedByClient, newData.stageDates.stampedByClient)
        && stageUnchanged(oldData.stages.downPayment, newData.stages.downPayment, oldData.stageDates.downPayment, newData.stageDates.downPayment)
        && stageUnchanged(oldData.stages.supply, newData.stages.supply, oldData.stageDates.supply, newData.stageDates.supply)
        && stageUnchanged(oldData.stages.settlement, newData.stages.settlement, oldData.stageDates.settlement, newData.stageDates.settlement);

      let completeDownPayment =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageCompleted(oldData.stages.downPayment, newData.stages.downPayment, newData.stageDates.downPayment)
        && stageUnchanged(oldData.stages.supply, newData.stages.supply, oldData.stageDates.supply, newData.stageDates.supply)
        && stageUnchanged(oldData.stages.settlement, newData.stages.settlement, oldData.stageDates.settlement, newData.stageDates.settlement);

      let completeSupply =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageUnchanged(oldData.stages.downPayment, newData.stages.downPayment, oldData.stageDates.downPayment, newData.stageDates.downPayment)
        && stageCompleted(oldData.stages.supply, newData.stages.supply, newData.stageDates.supply)
        && stageUnchanged(oldData.stages.settlement, newData.stages.settlement, oldData.stageDates.settlement, newData.stageDates.settlement);

      let completeStockingPayment =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageUnchanged(oldData.stages.downPayment, newData.stages.downPayment, oldData.stageDates.downPayment, newData.stageDates.downPayment)
        && stageUnchanged(oldData.stages.supply, newData.stages.supply, oldData.stageDates.supply, newData.stageDates.supply)
        && stageCompleted(oldData.stages.settlement, newData.stages.settlement, newData.stageDates.settlement);

      // Reopening one stage is allowed to clear that stage and every stage
      // after it, but it can never alter an earlier completed stage.
      let reopenStampedByUs =
        stageReopened(oldData.stages.stampedByUs, newData.stages.stampedByUs, newData.stageDates.stampedByUs)
        && newData.stages.stampedByClient == false && newData.stageDates.stampedByClient == null
        && newData.stages.downPayment == false && newData.stageDates.downPayment == null
        && newData.stages.supply == false && newData.stageDates.supply == null
        && newData.stages.settlement == false && newData.stageDates.settlement == null;

      let reopenStampedByClient =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageReopened(oldData.stages.stampedByClient, newData.stages.stampedByClient, newData.stageDates.stampedByClient)
        && newData.stages.downPayment == false && newData.stageDates.downPayment == null
        && newData.stages.supply == false && newData.stageDates.supply == null
        && newData.stages.settlement == false && newData.stageDates.settlement == null;

      let reopenDownPayment =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageReopened(oldData.stages.downPayment, newData.stages.downPayment, newData.stageDates.downPayment)
        && newData.stages.supply == false && newData.stageDates.supply == null
        && newData.stages.settlement == false && newData.stageDates.settlement == null;

      let reopenSupply =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageUnchanged(oldData.stages.downPayment, newData.stages.downPayment, oldData.stageDates.downPayment, newData.stageDates.downPayment)
        && stageReopened(oldData.stages.supply, newData.stages.supply, newData.stageDates.supply)
        && newData.stages.settlement == false && newData.stageDates.settlement == null;

      let reopenStockingPayment =
        stageUnchanged(oldData.stages.stampedByUs, newData.stages.stampedByUs, oldData.stageDates.stampedByUs, newData.stageDates.stampedByUs)
        && stageUnchanged(oldData.stages.stampedByClient, newData.stages.stampedByClient, oldData.stageDates.stampedByClient, newData.stageDates.stampedByClient)
        && stageUnchanged(oldData.stages.downPayment, newData.stages.downPayment, oldData.stageDates.downPayment, newData.stageDates.downPayment)
        && stageUnchanged(oldData.stages.supply, newData.stages.supply, oldData.stageDates.supply, newData.stageDates.supply)
        && stageReopened(oldData.stages.settlement, newData.stages.settlement, newData.stageDates.settlement);

      return unchanged
        || completeStampedByUs
        || completeStampedByClient
        || completeDownPayment
        || completeSupply
        || completeStockingPayment
        || reopenStampedByUs
        || reopenStampedByClient
        || reopenDownPayment
        || reopenSupply
        || reopenStockingPayment;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /contracts/{contractId} {
      allow read: if activeMember();

      allow create: if activeMember()
        && validContract(request.resource.data)
        && pristineWorkflow(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName == get(memberPath()).data.displayName
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeMember()
        && validContract(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validStageTransitions(resource.data, request.resource.data);

      allow delete: if admin();
    }
  }
}
